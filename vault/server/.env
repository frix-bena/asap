DATABASE_URL="postgresql://postgres:password@localhost:5433/vaultdb"
JWT_SECRET="replace-with-a-strong-256bit-secret"
PORT=5000
NODE_ENV=development

# ── Safaricom Daraja ───────────────────────────────────────────────────
MPESA_ENV=sandbox                          # "sandbox" or "production"
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret

# STK Push
MPESA_SHORTCODE=174379                     # Sandbox: 174379 | Prod: your Paybill/Till
MPESA_PASSKEY=your_lipa_na_mpesa_passkey
MPESA_STK_CALLBACK=https://yourdomain.com/api/mpesa/stk-callback

# B2C
MPESA_B2C_INITIATOR=your_initiator_name
MPESA_B2C_SECURITY_CREDENTIAL=your_encrypted_credential
MPESA_B2C_RESULT_URL=https://yourdomain.com/api/mpesa/b2c-result
MPESA_B2C_TIMEOUT_URL=https://yourdomain.com/api/mpesa/b2c-timeout
