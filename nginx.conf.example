server {
    listen 80;
    server_name yourdomain.com www.yourdomain.com; # Replace with your domain or IP

    # Route all /api requests to the Node.js/Express backend
    location /api/ {
        proxy_pass http://127.0.0.1:4000; # Assuming Express runs on port 4000
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        
        # Forward real IP to backend (useful for rate limiting, etc.)
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_addressee;
    }

    # Route everything else to the Next.js frontend
    location / {
        proxy_pass http://127.0.0.1:3000; # Assuming Next.js runs on port 3000
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }
}
